#hasheq(
 (version . 1)
 (requirements
  . (#hasheq((kind . contract) (platforms . (linux)))
     #hasheq((kind . bridge) (platforms . (linux)))
     #hasheq((kind . native-build) (platforms . (linux)))
     #hasheq((kind . package) (platforms . (linux)))
     #hasheq((kind . native-ui) (platforms . (linux)))))
 (suites
  . (#hasheq((id . core-contract)
             (kind . contract)
             (platforms . (linux))
             (command . ("raco" "test" "tests/"))
             (timeout-seconds . 900))
     #hasheq((id . embedded-wire)
             (kind . bridge)
             (platforms . (linux))
             (command . ("raco" "test" "tests/backend-wire-test.rkt"))
             (timeout-seconds . 300))
     #hasheq((id . linux-host)
             (kind . native-build)
             (platforms . (linux))
             (command . ("raco" "rivet" "build"))
             (timeout-seconds . 1800))
     #hasheq((id . linux-package)
             (kind . package)
             (platforms . (linux))
             (command . ("racket" "scripts/acceptance/package.rkt"))
             (timeout-seconds . 1800)
             (evidence . (".rivet/acceptance/linux/package.json")))
     #hasheq((id . linux-native-ui)
             (kind . native-ui)
             (platforms . (linux))
             (command . ("bash" "scripts/e2e/e2e-linux.sh"))
             (timeout-seconds . 600)
             (evidence . (".rivet/acceptance/linux/interaction-trace.json"
                          ".rivet/acceptance/linux/accessibility.json"))))))
